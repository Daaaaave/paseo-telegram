{
  "name": "paseo-telegram",
  "version": "0.2.0",
  "type": "module",
  "description": "Connect Telegram DMs, groups and topics to Paseo chats and workspaces, with optional Bots profiles.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:daemon": "node scripts/check-daemon.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.11.2",
    "entities": "8.1.0",
    "marked": "18.1.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@types/node": "24.10.0",
    "@types/react": "19.1.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "zod": "4.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "npm-shrinkwrap.json",
    "assets/"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "telegram",
    "bot",
    "chat",
    "groups",
    "topics",
    "agents"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daaaaave/paseo-telegram.git"
  },
  "homepage": "https://github.com/Daaaaave/paseo-telegram#readme",
  "bugs": {
    "url": "https://github.com/Daaaaave/paseo-telegram/issues"
  }
}
