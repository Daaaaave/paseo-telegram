{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "react"]
  },
  "include": [
    "index.server.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
